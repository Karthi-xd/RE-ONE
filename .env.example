# RE:ONE environment configuration
# Copy this file to .env and fill in real values.

# Backend
# APP_ENV=development
# APP_HOST=0.0.0.0
# APP_PORT=8000

# LLM provider
# OPENAI_API_KEY=your-openai-api-key
# LLM_MODEL=gpt-4o

# Embeddings
# EMBEDDING_MODEL=text-embedding-3-small

# Vector database (ChromaDB)
# CHROMA_DIR=../data/chroma
